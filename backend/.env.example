# Copy this file to .env and fill in real values.
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Required -------------------------------------------------------------
SECRET_KEY=replace_with_generated_secret
JWT_SECRET_KEY=replace_with_another_generated_secret

# SQLite is fine for development. Production should be Postgres: SQLite takes a
# write lock for the whole database, so it cannot serve concurrent users.
# DATABASE_URL=sqlite:///carbon.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/carbon
DATABASE_URL=sqlite:///carbon.db

# --- Optional -------------------------------------------------------------
# "development" or "production". In production the app refuses to start
# while SECRET_KEY / JWT_SECRET_KEY are still the placeholders above, while
# the auth cookie is not marked Secure, or while CORS_ORIGINS is "*".
FLASK_ENV=development

# --- Password reset -------------------------------------------------------
# Reset links are built from this. In development the link is returned in the
# API response instead, because there is no inbox to check.
PASSWORD_RESET_TTL_MINUTES=30
PUBLIC_BASE_URL=http://localhost:5173

# --- Email confirmation ----------------------------------------------------
# How long a confirmation link stays valid.
EMAIL_VERIFICATION_TTL_MINUTES=1440

# Refuse to send a reset link to an unconfirmed address. This is the point of
# having confirmation at all: anyone can register your address, and a reset link
# mailed to it would land in your inbox. Set false only to allow resets without
# working mail, since nothing can ever be confirmed without it.
RESET_REQUIRES_VERIFIED_EMAIL=true

# --- Outbound email -------------------------------------------------------
# Off by default, so development sends nothing and writes the link to the log
# instead. Both MAIL_ENABLED and MAIL_HOST must agree or the app refuses to
# start, so a half-configured mailer cannot silently swallow reset emails.
MAIL_ENABLED=false
# MAIL_HOST=smtp.example.com
MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_SENDER=no-reply@localhost
MAIL_USE_TLS=true

# --- Sessions (httpOnly cookies) -------------------------------------------
# How long an access token stays valid, in minutes. The frontend silently
# refreshes it from the refresh cookie, so this is not a hard sign-out.
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Must be true in production; the app refuses to start otherwise.
# Defaults to true automatically when FLASK_ENV=production.
JWT_COOKIE_SECURE=false

# Lax by default. "Strict" is safer but blocks the cookie on any cross-site
# navigation, which breaks links from other apps into this one.
#
# Lax only works while the frontend and API are on the same *site*. Cookies
# ignore ports, so localhost:5173 -> localhost:5000 is fine. It stops being the
# same site across different registrable domains: app.example.com and
# api.example.com are cross-site, and a Lax cookie is then never sent at all.
# Nothing errors -- every login succeeds and every later request is
# unauthenticated. For that topology set the next variable instead.
JWT_COOKIE_SAMESITE=Lax

# Set true when the frontend and the API are on different registrable domains.
# Forces SameSite=None, which browsers only accept alongside Secure, so
# production startup fails if JWT_COOKIE_SECURE is off.
JWT_COOKIE_CROSS_SITE=false

# Off by default: every state-changing request is a JSON POST from an
# allowlisted origin, which a cross-site form cannot forge.
JWT_COOKIE_CSRF_PROTECT=false

# --- Browser access --------------------------------------------------------
# Comma-separated list of allowed origins. The Vite dev server is 5173.
# Never "*" while cookies are enabled; production startup rejects it.
CORS_ORIGINS=http://localhost:5173

# --- Schema ----------------------------------------------------------------
# Leave false. Use `flask db upgrade` to change the schema; create_all()
# cannot alter existing tables.
AUTO_CREATE_TABLES=false

# Compare the applied migration against the head at startup and refuse to serve
# if they differ. Catches the commonest deployment mistake there is: pulling and
# forgetting `flask db upgrade`, which otherwise produces a running app whose
# every request fails with a missing-column error.
#
# `flask db ...` itself is exempt, so the command that fixes a stale database is
# never the command that refuses to run.
CHECK_SCHEMA_ON_STARTUP=true

# --- Rate limiting ---------------------------------------------------------
# In-memory by default: resets on restart and is not shared between workers.
# Set this to Redis for any multi-process deployment, e.g.
#   RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
#
# Use 127.0.0.1 rather than localhost. On most machines localhost resolves to
# ::1 first, Docker and Redis publish only IPv4, and the client waits out the
# connect timeout before falling back -- measured at a 21 second penalty on the
# first request.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10 per minute
REGISTER_RATE_LIMIT=5 per hour
CALCULATE_RATE_LIMIT=120 per minute
READ_RATE_LIMIT=120 per minute
# Tighter than login: reset tokens are the thing being guessed. Also applies to
# email confirmation.
RESET_RATE_LIMIT=5 per hour

# Deletion is irreversible, so it is deliberately hard to trigger.
DELETE_RATE_LIMIT=3 per hour

# Six digits is a million possibilities, so the code-check endpoint is tighter
# than login even though login is already rate limited. Enrolment and removal
# change an account's security posture and get their own, much tighter budget.
TOTP_RATE_LIMIT=5 per minute
TOTP_MANAGE_RATE_LIMIT=5 per hour

# Number of worker processes. Only read by Config.validate(), which refuses to
# start in production when this is above 1 while RATELIMIT_STORAGE_URI is
# memory:// -- the limiter counts per process, so every limit is silently
# multiplied by the worker count.
# WEB_CONCURRENCY=1

# --- Password hygiene ------------------------------------------------------
# Refuse a password that appears in the Have I Been Pwned corpus, checked when a
# password is chosen (registration and reset) rather than at every login. Only the
# first five characters of the SHA-1 digest are sent, so the password itself never
# leaves the machine, and there is no API key.
#
# Fails open: a network error or timeout lets the password through, because a
# breach check that can lock every user out during someone else's outage is worse
# than no breach check.
BREACH_CHECK_ENABLED=true
BREACH_CHECK_TIMEOUT_SECONDS=2

# --- Two-factor authentication (optional) ----------------------------------
# Encrypts TOTP seeds at rest. A seed cannot be hashed -- verification needs the
# original bytes -- so without this a leaked database yields working codes for
# every enrolled account. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Leaving it unset is allowed: 2FA is opt-in, and POST /auth/mfa/start then answers
# 503 with an actionable message rather than the app refusing to boot. A key that
# is set but malformed is rejected at startup, since it makes 2FA fail for every
# user while looking configured.
#
# Separate from SECRET_KEY on purpose. Reusing one key for two jobs means a bug in
# either leaks both, and rotating the session secret would silently lock everyone
# out of their authenticators.
# TOTP_ENCRYPTION_KEY=

# Shown as the issuer inside the authenticator app. A user with several services
# cannot tell the entries apart without it.
TOTP_ISSUER=carbon-app

# Single-use codes issued at enrolment, shown once. Each is one login if the
# authenticator is lost.
TOTP_RECOVERY_CODES=10

# Also require the password to turn 2FA off. A second factor that anyone holding
# the session can remove is not a second factor: whoever phished the password
# would simply switch it off. Turning it off also revokes every session.
TOTP_DISABLE_REQUIRES_PASSWORD=true

# --- Reverse proxy ---------------------------------------------------------
# Number of trusted proxies in front of the app. 0 means none, which is correct
# for `python app.py` and wrong for anything behind a load balancer.
#
# Set this too high and any client can send X-Forwarded-Proto: https and make
# the app believe it is served over TLS, which decides the Secure cookie flag.
# Keep it equal to the number of proxies actually in front, and match gunicorn's
# FORWARDED_ALLOW_IPS to the same value.
PROXY_FIX_X_FOR=0

# How often a session's last_seen_at is written. Lowering this turns every API
# call into a database update.
SESSION_TOUCH_INTERVAL_SECONDS=300

# Max accepted request body, in bytes (default 16384).
MAX_CONTENT_LENGTH=16384

# --- Input limits (rarely need changing) ----------------------------------
MIN_PASSWORD_LENGTH=8
MAX_CAR_KM=1000000
MAX_ELECTRICITY_KWH=1000000
MAX_MEALS=100000

# Port for `python app.py`
PORT=5000